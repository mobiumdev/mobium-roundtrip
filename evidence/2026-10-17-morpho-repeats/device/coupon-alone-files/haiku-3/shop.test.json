{
  "app": "dev.mobium.shop",
  "beforeEach": [
    {
      "dialogs": {
        "press": "Open",
        "when": "Morpho Market"
      }
    },
    {
      "open_url": "mobiumshop://reset"
    },
    {
      "wait_for": {
        "target": "testid=catalogList",
        "condition": "visible",
        "timeout_ms": 3000
      }
    }
  ],
  "tests": [
    {
      "name": "codes refused, each saying why",
      "description": "Each refused code shows the reason it was refused.",
      "steps": [
        {
          "tap": "testid=product_pins"
        },
        {
          "tap": "testid=qtyPlus"
        },
        {
          "tap": "testid=addToCart"
        },
        {
          "tap": "testid=viewCart"
        },
        {
          "fill": {
            "target": "testid=codeField",
            "text": "MOBIUM5"
          }
        },
        {
          "tap": "testid=applyCode"
        },
        {
          "wait_for": {
            "target": "testid=codeMessage",
            "condition": "text",
            "exact": true,
            "text": "Add $6.00 more to use this code."
          }
        },
        {
          "fill": {
            "target": "testid=codeField",
            "text": "EXPIRED20"
          }
        },
        {
          "tap": "testid=applyCode"
        },
        {
          "wait_for": {
            "target": "testid=codeMessage",
            "condition": "text",
            "exact": true,
            "text": "That code has expired.",
            "timeout_ms": 3000
          }
        },
        {
          "wait_for": {
            "target": "testid=sumDiscount",
            "condition": "hidden",
            "timeout_ms": 2000
          }
        },
        {
          "fill": {
            "target": "testid=codeField",
            "text": "FREESTUFF"
          }
        },
        {
          "tap": "testid=applyCode"
        },
        {
          "wait_for": {
            "target": "testid=codeMessage",
            "condition": "text",
            "exact": true,
            "text": "That code isn't valid."
          }
        }
      ]
    }
  ]
}